# ==========================
# Gemini API Keys
# ==========================
# Add up to N keys for automatic rotation.
# The backend tries each key in order before falling back to Groq.
GEMINI_API_KEY_1=your-gemini-api-key-here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# ==========================
# Groq Backup
# ==========================
# Optional. Used as the last-resort provider after all Gemini keys are exhausted.
GROQ_API_KEY=your-groq-api-key-here

# ==========================
# Server
# ==========================
HOST=0.0.0.0
PORT=8000
DEBUG=False